{
  "name": "hrms",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "server": "npm run dev --prefix HRMS-Server",
    "client": "npm run dev --prefix HRMS-Ui",
    "user": "node HRMS-Server/scripts/create-user.mjs",
    "dev": "concurrently --kill-others --prefix \"[{name}]\" --names \"BACKEND,FRONTEND\" --prefix-colors \"red,blue\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix HRMS-Server && npm run build --prefix HRMS-Ui",
    "start": "concurrently --kill-others --prefix \"[{name}]\" --names \"BACKEND,FRONTEND\" --prefix-colors \"red,blue\" \"npm run start --prefix HRMS-Server\" \"npm run start --prefix HRMS-Ui\""
  },
  "workspaces": [
    "HRMS-Server",
    "HRMS-Ui"
  ],
  "author": "Wasib-2005",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
